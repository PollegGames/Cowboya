<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=2c84fc0a799d1534cb35b8bdafd0867b&amp;type=3#MainMenuStyle" />
    <engine:VisualElement name="Background" style="flex-grow: 1; background-image: resource(&apos;Menu/MenuBackgroundCustom&apos;); align-items: center; justify-content: flex-end; align-self: auto; align-content: flex-end;">
        <engine:VisualElement name="CenterSection" class="centerSection" style="flex-grow: 1; width: 50%; height: auto; align-items: stretch; align-self: center; align-content: stretch; justify-content: center; background-color: rgba(0, 0, 0, 0); flex-shrink: 1;">
            <engine:VisualElement name="Buttons" style="flex-grow: 1; align-items: center; justify-content: center; align-self: center; align-content: stretch; width: 100%; flex-direction: column; height: 100%;">
                <engine:Button name="PlayBtn" class="menuBtnStyle" style="width: 305px; justify-content: space-between; align-items: center; align-self: center; align-content: flex-end; font-size: 40px; background-color: rgba(206, 238, 208, 0); background-image: resource(&apos;Menu/StartCustomButton&apos;); height: 168px;" />
                <engine:Button name="SandboxBtn" class="menuBtnStyle" style="width: 452px; justify-content: space-between; align-items: center; align-self: center; align-content: flex-end; font-size: 40px; background-color: rgba(236, 238, 206, 0); background-image: resource(&apos;Menu/SanboxCustomButton&apos;); height: 190px;" />
                <engine:Button name="ExitBtn" class="menuBtnStyle" style="width: 361px; justify-content: space-between; align-items: center; align-self: center; align-content: flex-end; font-size: 40px; background-color: rgba(238, 211, 206, 0); background-image: resource(&apos;Menu/ExitCustomButton&apos;); height: 130px;" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
